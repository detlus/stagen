#!/usr/bin/env node

import packageJson from '../package.json' with { type: 'json' };
import minimist from 'minimist';
// var version = _version;
var help = `stagen ${packageJson.version} -- stagen is a static site generator.

Usage:
  stagen <subcommand> [options]

Options:
  -s, --source [DIR] Source directory (defaults to ./)
  -h, --help         Show this message
  -v, --version      Print the name and version
  --clean            Clean site output prior to generating

Subcommands:
  build         Build the site
  build-single  Generate output for single content item
  clean         Clean the destination directoy
  serve         Publishes site on HTTP server and watches for changes.

build-single:
  -c       Content file to process
serve
  --nowatch     Just serve content using HTTP server. Do not listen to changes.
  --port        Port number [8080]
  --host        Hostname [0.0.0.0]
`;

var argv = minimist(process.argv.slice(2), {boolean: true});

if (argv.h) {
  // Show help text.
  console.log(help);
  process.exit();
}
else if(argv.v) {
  // Show version info.
  console.log(`stagen ${version}`);
  process.exit();
}
var subcommands = ['build', 'build-single', 'clean', 'serve'];
if (subcommands.indexOf(argv._[0]) !== -1) {
  // require(`../lib/subcommands/${argv._[0]}`)(argv);
  // import(`../lib/subcommands/${argv._[0]}`)
  //   .then(command => {
  //     console.log(command);
  //     command(argv);
  //   })
  //   .catch(err => console.error(err));
  const command = await import(`../lib/subcommands/${argv._[0]}.mjs`);
  command.command(argv);
}
else {
  // User did not provide any option or command.
  // Show help message.
  console.log(help);
  process.exit(1);
}
